# Backend API image (#824 slice 1b, Task 2).
#
# Build context is the REPO ROOT, not backend/ — even though the Go module
# lives at backend/go.mod. Two reasons: (1) the module has no dependency
# outside backend/ (no `replace` directives, nothing reaches up past its own
# tree), so nothing outside backend/ actually needs to be in the build
# context; but (2) every other build/verify entry point in this repo (make
# targets, CI) is invoked from the repo root, and a root-context build lets
# `docker build -f Dockerfile.api .` be run the same way from the same place
# as everything else, with .dockerignore (also at the root) as the one place
# that decides what can leak into any image built here — not a second,
# backend-local .dockerignore that could drift from it.
#
# Tesserix rebuilds and Trivy-gates this company-owned builder every week.
# `latest` is the last green weekly build, so an upstream Go or Alpine patch
# reaches HMS without duplicating base-image maintenance in this repository.
FROM ghcr.io/tesserix/base-go-builder:latest AS builder

# The shared builder defaults to the non-root app user. This stage needs to
# create /out and populate the module/build caches, so elevate only for the
# disposable build stage; the final image remains distroless and non-root.
USER 0:0

WORKDIR /src

# Dependency layer cached separately from source: go.sum changes far less
# often than application code, so this layer only re-runs when a dependency
# actually changes.
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

# Stamped via -X main.version / main.commit — see backend/cmd/api/main.go's
# `version`/`commit` vars, which default to "dev"/"unknown" for `go run` and
# `go test`, where no linker flags are supplied. VERSION/COMMIT default here
# too, so an un-parameterised `docker build` still produces a working,
# clearly-labelled image rather than failing on an unset build arg.
#
# CGO_ENABLED=0 is required, not just an optimisation: the final stage
# (distroless/static) ships no libc, so a cgo-linked binary would fail to
# start with "no such file or directory" on its own dynamic loader.
#
# Only cmd/api is built here. backend/cmd/migrate and backend/cmd/session-key
# are deliberately NOT part of this image — migrate runs separately as a
# Helm hook (a later task), and session-key is a one-off local operator
# tool. Shipping either alongside the API binary would put a
# cmd/session-key is deliberately NOT shipped: it mints signing keys and has
# no business in a container that serves production traffic.
#
# cmd/migrate IS shipped, and that reverses an earlier decision. The chart
# runs migrations as a Helm pre-upgrade hook Job, which needs an image
# containing the binary — and shipping it HERE rather than as a separate
# image makes version skew structurally impossible: the migrations and the
# API that expects them are the same artifact, so an operator cannot deploy
# an API built from one commit against migrations built from another. For a
# database holding patient records that is a correctness property, not a
# convenience. It also halves the supply-chain surface — one image to build,
# scan, sign and promote.
#
# The cost is a binary the API pod never executes. That is bounded: this
# image has no shell (see the final stage), so /app/migrate cannot be invoked
# without an explicit command override in a pod spec.
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/api \
    ./cmd/api

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w" \
    -o /out/migrate \
    ./cmd/migrate

# The company-owned distroless image is a Trivy-gated passthrough of
# distroless/static:nonroot. It has no shell, package manager, or libc and
# runs the static binaries as UID/GID 65532. `latest` tracks only the last
# green weekly base build.
FROM ghcr.io/tesserix/base-distroless-static:latest

WORKDIR /app
COPY --from=builder /out/api /app/api

# The migration runner. The API pod never executes this; the chart's
# pre-upgrade hook Job runs it with command: ["/app/migrate"].
COPY --from=builder /out/migrate /app/migrate

# The base image's own USER directive already runs the container as
# 65532:65532 ("nonroot") — nothing to set here. Left unset deliberately
# rather than repeating `USER nonroot`, so there is exactly one place
# (the base image tag) that decides the identity this image runs as.

EXPOSE 8080

# Exec form: the binary IS PID 1, with no /bin/sh -c wrapper in between to
# intercept or swallow SIGTERM before main.go's signal.NotifyContext (see
# main.go:136) ever sees it. A shell-form or CMD-based ENTRYPOINT here would
# put a shell at PID 1 instead — and distroless has no shell to do that
# with anyway, so this is also the only form that could ever work.
ENTRYPOINT ["/app/api"]
