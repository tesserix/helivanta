{
  "expo": {
    "name": "AmbulanceConnect",
    "slug": "helivanta-ambulanceconnect",
    "version": "0.1.0",
    "scheme": "helivanta-ambulanceconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.helivanta.ambulanceconnect",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.helivanta.ambulanceconnect",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
