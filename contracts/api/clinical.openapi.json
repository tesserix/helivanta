{
  "openapi": "3.1.0",
  "info": {
    "title": "Helivanta current clinical API reference",
    "version": "0.1.0",
    "description": "Descriptive baseline at 2295017, reviewed 2026-10-22. Covers 11 operations only: legacy visits, laboratory orders/results, legacy pharmacy tasks/medications and insights. Not an approved comprehensive external API, FHIR service or claim of universal hospital isolation. Existing handlers remain authoritative pending conformance adoption."
  },
  "servers": [
    {
      "url": "/",
      "description": "Backend origin; paths already include /v1. Configure the actual same-origin proxy explicitly."
    }
  ],
  "security": [
    {
      "helivantaSession": []
    },
    {
      "helivantaBearer": []
    }
  ],
  "paths": {
    "/v1/medicore/visits": {
      "post": {
        "operationId": "createVisit",
        "summary": "Create a legacy OPD/IPD visit",
        "tags": ["medicore"],
        "description": "Commits visit and outbox atomically. No durable request deduplication key. A timeout requires reconciliation, not blind retry. Patient ID is optional and is not a validated hospital care relationship. Lab and pharmacy consumers currently create pending work for every visit.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/medicore/visits.go",
        "x-permission": "medicore.visit.create",
        "responses": {
          "202": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identifier"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitInput"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listVisits",
        "summary": "List tenant visits",
        "tags": ["medicore"],
        "description": "Newest first by creation time and UUID. This legacy table is tenant-scoped, not a bed/admission ledger.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/medicore/visits.go",
        "x-permission": "medicore.visit.read",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/v1/lab/orders": {
      "get": {
        "operationId": "listLabOrders",
        "summary": "List tenant laboratory orders",
        "tags": ["lab"],
        "description": "Pending default CBC orders currently originate from visit intake. Not a full specimen/report lifecycle.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/lab/orders.go",
        "x-permission": "lab.order.read",
        "responses": {
          "200": {
            "description": "Successful operation.",
