        "tags": ["lab"],
        "description": "Counts records created in the selected window grouped by status: pending, completed. These are current category counts by creation bucket, not historical state-transition rates, occupancy or completed-work TAT. Range is inclusive from/to, at most five years and 366 output buckets. Unknown or duplicate query parameters return 400.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/platform/insights/counts.go",
        "x-permission": "lab.order.read",
        "responses": {
          "200": {
