              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabOrderPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/v1/lab/orders/{id}/result": {
      "post": {
        "operationId": "recordLabResult",
        "summary": "Complete a pending laboratory order",
        "tags": ["lab"],
        "description": "Guarded pending-to-completed update and result_ready event in one transaction. A repeated/concurrent completion returns 409, not replayed success. Missing/invisible order returns 404. No signed report/amendment semantics are implied.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/lab/orders.go",
        "x-permission": "lab.order.fulfil",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultInput"
              }
            }
          }
        }
      }
    },
    "/v1/pharmacy/dispenses": {
      "get": {
        "operationId": "listDispenses",
        "summary": "List legacy tenant dispense tasks",
        "tags": ["pharmacy"],
        "description": "Tenant-level legacy queue, separate from outlet catalogue/stock APIs.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/pharmacy/dispenses.go",
        "x-permission": "pharmacy.dispense.read",
        "responses": {
