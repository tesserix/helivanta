  },
  "components": {
    "securitySchemes": {
      "helivantaSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "helivanta_session"
      },
      "helivantaBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Verified Helivanta session token, not a raw Zitadel ID token or assumed OAuth client-credentials token."
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "description": "Out-of-range or malformed values return 400; no silent clamp."
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Opaque cursor from prior page. Preserve tenant and filter scope."
      },
      "ExpectedTenant": {
        "name": "X-Helivanta-Expected-Tenant",
        "in": "header",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Optional precondition, never tenant selection. A supplied header must be exactly one nonzero UUID matching the verified session; otherwise 409 session_changed."
      }
    },
    "responses": {
      "Error": {
        "description": "Current error envelope. Known codes include invalid_request, unauthenticated, forbidden, not_found, conflict, rate_limited, internal and authz_unavailable. Domain codes and details can be added. X-Request-ID carries correlation.",
        "headers": {
          "X-Request-ID": {
            "schema": {
              "type": "string"
            }
          },
          "Retry-After": {
            "description": "Present on 429, integer seconds.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["error", "message"]
      },
      "Identifier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["id"]
      },
      "Page": {
        "type": "object",
        "properties": {
          "next_cursor": {
            "type": ["string", "null"]
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": ["next_cursor", "has_more"]
      },
      "VisitInput": {
        "type": "object",
        "properties": {
          "patient_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "department": {
            "type": "string",
            "enum": ["OPD", "IPD"]
          },
          "patient_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "const": ""
              }
            ],
            "description": "Optional legacy linkage. Handler parses the UUID but does not validate hospital access or patient existence."
          }
        },
        "required": ["patient_name", "department"]
      },
      "Visit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_name": {
            "type": "string"
          },
          "patient_id": {
            "type": "string",
            "format": "uuid"
          },
          "department": {
            "type": "string",
            "enum": ["OPD", "IPD"]
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "patient_name", "department", "status", "created_at"]
      },
      "LabOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visit_id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_name": {
            "type": "string"
          },
          "test_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "completed"]
          },
          "result_value": {
            "type": ["string", "null"]
          },
          "resulted_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "visit_id",
          "patient_name",
          "test_name",
          "status",
          "result_value",
          "resulted_at",
          "created_at"
        ]
      },
      "ResultInput": {
        "type": "object",
        "properties": {
          "result_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": ["result_value"]
      },
      "CompletedResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": ["id", "status"]
      },
      "Dispense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visit_id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_name": {
            "type": "string"
          },
          "medication": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "dispensed"]
          },
          "dispensed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "visit_id",
          "patient_name",
          "medication",
          "status",
          "dispensed_at",
          "created_at"
        ]
      },
      "DispenseInput": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["medication"]
      },
      "CompletedDispense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "dispensed"
          }
        },
        "required": ["id", "status"]
      },
      "MedicationInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "strength": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": ["name"]
      },
      "Medication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "created_at": {
