        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/ExpectedTenant"
          }
        ]
      }
    },
    "/v1/pharmacy/dispenses/{id}/dispense": {
      "post": {
        "operationId": "completeDispense",
        "summary": "Complete a pending legacy dispense task",
        "tags": ["pharmacy"],
        "description": "Guarded pending-to-dispensed update and event. Repeated/concurrent completion returns 409. This handler does not validate a signed prescription, deduct outlet stock or post a hospital charge.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/pharmacy/dispenses.go",
        "x-permission": "pharmacy.dispense.fulfil",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedDispense"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/ExpectedTenant"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DispenseInput"
              }
            }
          }
        }
      }
    },
    "/v1/pharmacy/medications": {
      "get": {
        "operationId": "listMedications",
        "summary": "List legacy tenant medication records",
        "tags": ["pharmacy"],
        "description": "Separate from the outlet product catalogue with ingredients/packs/batches.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/pharmacy/medications.go",
        "x-permission": "pharmacy.medication.read",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedicationPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/ExpectedTenant"
          }
        ]
      },
      "post": {
        "operationId": "createMedication",
        "summary": "Create a legacy medication record",
        "tags": ["pharmacy"],
        "description": "No documented request deduplication key. Does not create an outlet stock product or movement.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/modules/pharmacy/medications.go",
        "x-permission": "pharmacy.medication.write",
        "responses": {
          "201": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identifier"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ExpectedTenant"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicationInput"
              }
            }
          }
        }
      }
    },
    "/v1/medicore/insights": {
      "get": {
        "operationId": "medicoreInsights",
        "summary": "Read bounded calendar counts",
        "tags": ["medicore"],
        "description": "Counts records created in the selected window grouped by department: OPD, IPD. These are current category counts by creation bucket, not historical state-transition rates, occupancy or completed-work TAT. Range is inclusive from/to, at most five years and 366 output buckets. Unknown or duplicate query parameters return 400.",
        "x-contract-status": "descriptive-current",
        "x-source": "backend/internal/platform/insights/counts.go",
        "x-permission": "medicore.visit.read",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Insights"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Calendar date from 2000 through 2199."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive date, at or after from; maximum five-year window."
          },
          {
            "name": "timezone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "IANA timezone; Local is refused."
          },
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["day", "week", "month", "year"]
            }
          }
        ]
      }
    },
    "/v1/lab/insights": {
      "get": {
        "operationId": "labInsights",
