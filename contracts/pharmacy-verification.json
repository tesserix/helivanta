{
  "status": "draft_not_registered",
  "blank_note_characters": "\t\n\u000b\f\r \u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff",
  "decisions": {
    "approved": {
      "requires_reason": false,
      "requires_amendment": false
    },
    "approved_with_change": {
      "requires_reason": true,
      "requires_amendment": true
    },
    "query_raised": {
      "requires_reason": true,
      "requires_amendment": false
    },
    "rejected": {
      "requires_reason": true,
      "requires_amendment": false
    }
  },
  "models": {
    "PrescriptionVerificationDecisionInput": [
      {
        "name": "decision",
        "type": "string",
        "enum": ["approved", "approved_with_change", "query_raised", "rejected"]
      },
      {
        "name": "reason_code",
        "type": "string",
        "min": 1,
        "max": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "pointer": true,
        "nullable": true
      },
      {
        "name": "clinical_note",
        "type": "string",
        "min": 1,
        "max": 2000,
        "no_nul": true,
        "pointer": true,
        "nullable": true
      },
      {
        "name": "prescriber_amendment_id",
        "type": "uuid",
        "pointer": true,
        "nullable": true
      }
    ],
    "PrescriptionVerificationSecondCheckInput": [
      {
        "name": "primary_decision_id",
        "type": "uuid"
      }
    ]
  },
  "precondition_fields": [
    {
      "name": "expected_version",
      "type": "int64",
      "min": 1,
      "max": 9007199254740991
    },
    {
      "name": "reviewed_state_hash",
      "type": "string",
      "min": 64,
      "max": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  ]
}
