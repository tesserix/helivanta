{
  "go_patterns": true,
  "models": [
    {
      "name": "ContactFields",
      "schema": "supplyContactSchema",
      "fields": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "name",
          "type": "string",
          "min": 1,
          "max": 200,
          "trim": true
        },
        {
          "name": "role",
          "type": "string",
          "enum": [
            "general",
            "purchasing",
            "finance",
            "pharmacist",
            "signatory",
            "emergency"
          ]
        },
        {
          "name": "email",
          "type": "string",
          "max": 254,
          "trim": true,
          "format": "optional_email"
        },
        {
          "name": "phone",
          "type": "string",
          "max": 16,
          "trim": true,
          "pattern": "^(?:|\\+[1-9][0-9]{7,14})$"
        },
        {
          "name": "alternate_phone",
          "type": "string",
          "max": 16,
          "trim": true,
          "pattern": "^(?:|\\+[1-9][0-9]{7,14})$"
        }
      ]
    },
    {
