          "max": 200,
          "trim": true
        },
        {
          "name": "line2",
          "type": "string",
          "max": 200,
          "trim": true
        },
        {
          "name": "city",
          "type": "string",
          "min": 1,
          "max": 100,
          "trim": true
        },
        {
          "name": "region",
          "type": "string",
          "min": 1,
          "max": 100,
          "trim": true
        },
        {
          "name": "postal_code",
          "type": "string",
          "min": 1,
          "max": 20,
          "trim": true
        },
        {
          "name": "country_code",
          "type": "string",
          "country_profile": true
        }
      ]
    },
    {
      "name": "AddressFields",
      "schema": "supplyAddressSchema",
      "fields": [
