{
  "statuses": {
    "unreviewed": "Not reviewed",
    "not_yet_valid": "Not yet valid",
    "valid": "Valid",
    "expires_today": "Expires today",
    "expired": "Expired",
    "date_unknown": "Set the hospital time zone"
  },
  "models": {
    "credentialReviewInput": [
      {
        "name": "expected_version",
        "type": "int64",
        "pointer": true,
        "min": 0,
        "binding": "required,gte=0"
      },
      {
        "name": "number",
        "type": "string",
        "format": "text",
        "min": 1,
        "max": 100,
        "binding": "required,max=100"
      },
      {
        "name": "valid_from",
        "type": "string",
        "format": "date",
        "binding": "required,len=10"
      },
      {
        "name": "valid_until",
        "type": "string",
        "format": "date",
        "binding": "required,len=10"
      },
      {
        "name": "evidence_document_ids",
        "type": "[]uuid",
        "max": 5,
        "binding": "required,min=1,max=5"
      },
      {
        "name": "reason",
        "type": "string",
        "format": "text",
        "min": 1,
        "max": 500,
        "binding": "required,max=500"
      }
    ],
    "credentialDecisionInput": [
      {
        "name": "expected_version",
        "type": "int64",
        "pointer": true,
        "min": 0,
        "binding": "required,gte=0"
      },
      {
        "name": "decision",
        "type": "string",
        "enum": ["approve", "reject"],
        "binding": "required,oneof=approve reject"
      },
      {
        "name": "note",
        "type": "string",
        "format": "text",
        "max": 500,
        "binding": "max=500"
      }
    ],
    "credentialWithdrawInput": [
      {
        "name": "note",
        "type": "string",
        "format": "text",
        "max": 500,
        "binding": "max=500"
      }
    ],
    "credentialReview": [
      {
        "name": "id",
        "type": "uuid"
      },
      {
        "name": "staff_id",
        "type": "uuid"
      },
      {
        "name": "credential_id",
        "type": "uuid"
      },
      {
        "name": "base_version",
        "type": "int64"
      },
      {
        "name": "status",
        "type": "string",
        "enum": ["pending", "approved", "rejected", "withdrawn"]
      },
      {
        "name": "approved_version",
        "type": "int64",
        "optional": true
      },
      {
        "name": "type",
        "type": "string"
      },
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "issuer",
        "type": "string"
      },
      {
        "name": "valid_from",
        "type": "string"
      },
      {
        "name": "valid_until",
        "type": "string"
      },
      {
        "name": "evidence_document_ids",
        "type": "[]uuid",
        "max": 5,
        "orm_ignore": true
      },
      {
        "name": "reason",
        "type": "string"
      },
      {
        "name": "proposed_by_subject",
        "type": "string"
      },
      {
        "name": "decided_by_subject",
        "type": "string",
        "optional": true
      },
      {
        "name": "decided_at",
        "type": "time",
        "optional": true
      },
      {
        "name": "decision_note",
        "type": "string"
      },
      {
        "name": "created_at",
        "type": "time"
      }
    ],
    "credentialReviewed": [
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "valid_from",
        "type": "string"
      },
      {
        "name": "valid_until",
        "type": "string"
      },
      {
        "name": "version",
        "type": "int64"
      },
      {
        "name": "review_id",
        "type": "uuid"
      },
      {
        "name": "updated_at",
        "type": "time"
      }
    ],
    "staffCredential": [
      {
        "name": "id",
        "type": "uuid"
      },
      {
        "name": "type",
        "type": "string"
      },
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "issuer",
        "type": "string"
      },
      {
        "name": "valid_from",
        "type": "string",
        "optional": true
      },
      {
        "name": "valid_until",
        "type": "string",
        "optional": true
      },
      {
        "name": "reviewed",
        "type": "credentialReviewed",
        "optional": true,
        "orm_ignore": true
      },
      {
        "name": "status",
        "type": "string",
        "enum": [
          "unreviewed",
          "not_yet_valid",
          "valid",
          "expires_today",
          "expired",
          "date_unknown"
        ]
      },
      {
        "name": "days_remaining",
        "type": "int",
        "optional": true
      },
      {
        "name": "pending",
        "type": "credentialReview",
        "optional": true,
        "orm_ignore": true
      }
    ],
    "staffCredentials": [
      {
        "name": "time_zone",
        "type": "string",
        "optional": true
      },
      {
        "name": "local_date",
        "type": "string",
        "optional": true
      },
      {
        "name": "credentials",
        "type": "[]staffCredential",
        "max": 20
      }
    ],
    "credentialRegisterEntry": [
      {
        "name": "staff_id",
        "type": "uuid"
      },
      {
        "name": "employee_code",
        "type": "string"
      },
      {
        "name": "display_name",
        "type": "string"
      },
      {
        "name": "credential_id",
        "type": "uuid"
      },
      {
        "name": "type",
        "type": "string"
      },
      {
        "name": "number",
        "type": "string"
      },
      {
        "name": "issuer",
        "type": "string"
      },
      {
        "name": "valid_from",
        "type": "string"
      },
      {
        "name": "valid_until",
        "type": "string"
      },
      {
        "name": "version",
        "type": "int64"
      },
      {
        "name": "review_id",
        "type": "uuid"
      },
      {
        "name": "status",
        "type": "string",
        "enum": [
          "unreviewed",
          "not_yet_valid",
          "valid",
          "expires_today",
          "expired",
          "date_unknown"
        ]
      },
      {
        "name": "days_remaining",
        "type": "int",
        "optional": true
      }
    ]
  }
}
