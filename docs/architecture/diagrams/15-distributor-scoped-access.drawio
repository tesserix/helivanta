<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="scoped-distributor-access" name="Distributor structure and access"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="PharmaConnect · Distributor structure and least-privilege access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="20" width="1340" height="50" /></mxCell><mxCell id="tenant" value="Tenant boundary&lt;br&gt;Verified session + current IAM membership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="110" width="280" height="100" /></mxCell><mxCell id="organisation" value="Owned legal organisation&lt;br&gt;Independent country registrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="110" width="280" height="100" /></mxCell><mxCell id="corporate" value="Corporate root / subsidiary&lt;br&gt;Relationship grants no access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="110" width="280" height="100" /></mxCell><mxCell id="premise" value="Warehouse / depot → bins&lt;br&gt;Owned by legal organisation&lt;br&gt;Optional branch grouping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="300" width="280" height="100" /></mxCell><mxCell id="territory" value="Territories and assigned sales users&lt;br&gt;Assignment requires an effective sales grant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="300" width="280" height="100" /></mxCell><mxCell id="authority" value="Every operation rechecks authority&lt;br&gt;Tenant capability ∩ organisation grant&lt;br&gt;Role + location + expiry + current state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="300" width="280" height="140" /></mxCell><mxCell id="operations" value="Inventory: canonical bin controls&lt;br&gt;Picker / packer: read operating context&lt;br&gt;Dispatcher: manual logistics tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="510" width="280" height="130" /></mxCell><mxCell id="driver" value="Driver: currently assigned task only&lt;br&gt;Generation + assignment expiry&lt;br&gt;No stock, credit, clinical or source details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="510" width="280" height="130" /></mxCell><mxCell id="support" value="Support: named request + independent approval&lt;br&gt;Exact premise, ticket, reason, ≤24h&lt;br&gt;Audited diagnostics only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="300" width="280" height="140" /></mxCell><mxCell id="policy" value="Versioned operational access limits&lt;br&gt;Limits apply to new / extended authority&lt;br&gt;Existing authority requires explicit revocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#567399;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="510" width="280" height="130" /></mxCell><mxCell id="postgres" value="One PostgreSQL transaction&lt;br&gt;Forced RLS + optimistic version + immutable history&lt;br&gt;Business row + audit + minimal outbox" st