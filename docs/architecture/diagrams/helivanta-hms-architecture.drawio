          <mxGeometry x="60" y="30" width="1480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="LOGICAL REQUEST SEQUENCE  /  Arrows show decision order, not a claim that policy services query clinical databases" style="text;html=0;align=left;fontSize=17;fontColor=#627186;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="1480" height="30" as="geometry" />
