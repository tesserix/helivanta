          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="bff" target="sts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="sts" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="api" target="policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="policy" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="db" target="audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="audit" target="response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="failure branch" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="policy" target="lock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="625" />
              <mxPoint x="1330" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;1  Browser + active hospital&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Secure HttpOnly cookie&lt;br&gt;Visible context • no raw IdP token&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b&gt;2  BFF validates session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;CSRF / Origin • current scope&lt;br&gt;Reject stale-tab context&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sts" value="&lt;b&gt;3  Session / token service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Short-lived target audience&lt;br&gt;Actor + tenant + hospital + epoch&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;4  Product API + Istio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Workload mTLS + allowed caller&lt;br&gt;Verify delegation and audience&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="425" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;5  API checks policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Membership • role • care relation&lt;br&gt;Sharing / purpose • current epoch&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="425" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;6  Scoped database transaction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Tenant AND hospital / grant RLS&lt;br&gt;Action, field and state validation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;7  Durable audit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Before PHI / success is released&lt;br&gt;Actor, resource and policy version&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;8  Authorized response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Minimum fields • no-store PHI&lt;br&gt;Source versions / freshness&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="&lt;b&gt;Scope or authority changed?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Deny / retry safely; clear stale UI&lt;br&gt;No cached allow as fallback&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff0ed;strokeColor=#bf7667;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Two distinct identities, both required&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Istio verifies the calling service. Helivanta verifies the user, tenant, hospital, purpose and record access.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  Proposed design · 2026-10-13  /  Blue: apps   Purple: identity/policy   Teal: data   Amber: async   Dashed: secondary/future" style="text;html=0;align=left;fontSize=15;fontColor=#6c7b8d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1360" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="04-tenant-onboarding" name="04 Onboard the group. Activate only after verification.">
    <mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0" background="#ffffff">
