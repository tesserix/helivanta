        </mxCell>
        <mxCell id="edge-7" value="offboarding is separately governed" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="active" target="close">
