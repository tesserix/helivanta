        <mxCell id="zc" value="&lt;b&gt;Zone C&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;BFF / API / policy replicas&lt;br&gt;Workers • strict mTLS&lt;br&gt;Requests • health • disruption budgets&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="365" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Private authoritative data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;HA PostgreSQL • separate product / identity roles&lt;br&gt;GCS files / PACS • current policy state&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="555" width="675" height="110" as="geometry" />
        </mxCell>
        <mxCell id="async" value="&lt;b&gt;Private supporting services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;NATS • Temporal • Valkey • OpenFGA&lt;br&gt;Future Qdrant behind retrieval gateway&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="815" y="555" width="675" height="110" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;Protected backup + WAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Independent credentials • locked retention&lt;br&gt;Keys + identity + objects + workflow state&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="795" width="450" height="135" as="geometry" />
        </mxCell>
        <mxCell id="restore" value="&lt;b&gt;Isolated recovery environment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Approved region • clean-room validation&lt;br&gt;Tenant / hospital repair, not shared rollback&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="575" y="795" width="450" height="135" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;Independent audit + monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Immutable evidence • policy / queue lag&lt;br&gt;SLO burn • restore and incident drills&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1090" y="795" width="450" height="135" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  Proposed design · 2026-10-13  /  Blue: apps   Purple: identity/policy   Teal: data   Amber: async   Dashed: secondary/future" style="text;html=0;align=left;fontSize=15;fontColor=#6c7b8d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1360" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="07-ai-retrieval" name="07 AI sees only data the current user may see.">
    <mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="AI sees only data the current user may see." style="text;html=0;align=left;fontSize=34;fontStyle=1;fontColor=#163c60;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="FUTURE CAPABILITY  /  Embeddings are sensitive derived data; core care works without AI" style="text;html=0;align=left;fontSize=17;fontColor=#627186;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="GOVERNED INGESTION" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;verticalAlign=top;align=left;spacingTop=18;spacingLeft=24;fontSize=19;fontStyle=1;fontColor=#52657d;fillColor=#f8fafc;strokeColor=#d0d9e4;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="650" height="710" as="geometry" />
        </mxCell>
        <mxCell id="query" value="AUTHORIZED RETRIEVAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;verticalAlign=top;align=left;spacingTop=18;spacingLeft=24;fontSize=19;fontStyle=1;fontColor=#52657d;fillColor=#f8fafc;strokeColor=#d0d9e4;" vertex="1" parent="1">
          <mxGeometry x="765" y="145" width="775" height="710" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="source" target="index">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="index" target="q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.49928057553956834;exitY=1.0;exitPerimeter=0;entryX=0.49928057553956834;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="request" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="filtered query" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=0.8103448275862069;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="check" target="q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="505" />
              <mxPoint x="745" y="630" />
              <mxPoint x="565" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" value="candidate IDs" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="q" target="reauth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.49928057553956834;exitY=1.0;exitPerimeter=0;entryX=0.7378378378378379;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="reauth" target="model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;Approved source records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Tenant + hospital + source version&lt;br&gt;Classification • sharing • retention&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="95" y="225" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="index" value="&lt;b&gt;Index worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Outbox trigger • approved model&lt;br&gt;Minimal content • policy metadata&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="95" y="450" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="q" value="&lt;b&gt;Private Qdrant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Mandatory tenant / hospital payload filters&lt;br&gt;Derived vectors + document references&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="680" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;User request → AI gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Current actor, tenant, hospital and purpose&lt;br&gt;No user/model override of scope&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="805" y="225" width="695" height="110" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;Authorize + retrieve candidate IDs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Policy computes allowed hospital/resource scope&lt;br&gt;Server injects filters; bounded retrieval&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="805" y="450" width="695" height="110" as="geometry" />
        </mxCell>
        <mxCell id="reauth" value="&lt;b&gt;Reauthorize each source before content&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Check revocation, current version and legal basis&lt;br&gt;Only then hydrate text from the owner&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="805" y="680" width="695" height="110" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;Approved model → cited draft → human review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Regional / contractual controls • no default training • restricted traces • delegated tools only&lt;br&gt;Source tombstones block stale vectors immediately. Provider or Qdrant outage disables AI, not core care.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="885" width="1480" height="105" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  Proposed design · 2026-10-13  /  Blue: apps   Purple: identity/policy   Teal: data   Amber: async   Dashed: secondary/future" style="text;html=0;align=left;fontSize=15;fontColor=#6c7b8d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1360" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="08-file-security" name="08 Uploads stay quarantined until release is proven.">
    <mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Uploads stay quarantined until release is proven." style="text;html=0;align=left;fontSize=34;fontStyle=1;fontColor=#163c60;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="CONFIRMED GCS + CLAMAV  /  Tenant and hospital ownership follows every object generation" style="text;html=0;align=left;fontSize=17;fontColor=#627186;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="upload" target="intent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="intent" target="gcs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="gcs" target="workflow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="workflow" target="clam">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="all checks pass" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="clam" target="promote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="promote" target="released">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="released" target="serve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="never release on uncertainty" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#63758d;strokeWidth=2;fontSize=15;fontColor=#52657d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="clam" target="blocked">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="635" />
              <mxPoint x="1330" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;1  User requests upload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Validate tenant / hospital / resource&lt;br&gt;Quota • category • current permission&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="intent" value="&lt;b&gt;2  File service creates intent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;PostgreSQL owns metadata and state&lt;br&gt;Opaque key • create-only upload&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gcs" value="&lt;b&gt;3  GCS quarantine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Private bucket • exact generation&lt;br&gt;Verify stored size, type and integrity&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="promote" value="&lt;b&gt;6  Promote verified generation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Copy exact scanned bytes; verify target&lt;br&gt;Commit available + audit + outbox&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="435" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="clam" value="&lt;b&gt;5  Isolated ClamAV worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Full scan + file / archive validation&lt;br&gt;Verdict binds hash and generation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="435" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="workflow" value="&lt;b&gt;4  JetStream → Temporal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Durable outbox • deduplicated start&lt;br&gt;Workflow ID = file ID + generation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="435" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="released" value="&lt;b&gt;7  GCS released files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Immutable destination generation&lt;br&gt;Uploaders cannot write here&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="serve" value="&lt;b&gt;8  Authorized delivery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Current hospital / record policy&lt;br&gt;Download, preview, OCR and AI gate&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="740" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="&lt;b&gt;Scan error / malware / limits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Remain quarantined and unavailable&lt;br&gt;Fresh signatures • bounded retries&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff0ed;strokeColor=#bf7667;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="740" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;A clean verdict belongs to the bytes scanned, not just the filename&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Source-generation preconditions prevent replacement races. ClamAV complements validation; it cannot certify every file as safe.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="915" width="1480" height="75" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  Proposed design · 2026-10-13  /  Blue: apps   Purple: identity/policy   Teal: data   Amber: async   Dashed: secondary/future" style="text;html=0;align=left;fontSize=15;fontColor=#6c7b8d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1360" height="30" as="geometry" />
