            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="draft" value="&lt;b&gt;1  Draft → approved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Legal entities • residency • hospitals&lt;br&gt;Subscriptions • accountable admin&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="id" value="&lt;b&gt;2  Provision identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Zitadel customer organization&lt;br&gt;Verified domains • MFA • invitations&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="hosp" value="&lt;b&gt;3  Provision hospital scopes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Hospital / facility records&lt;br&gt;Default isolated sharing • quotas&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;6  Synthetic verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Sibling-hospital and tenant denial&lt;br&gt;Login • audit • products • recovery&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;5  Reconcile authorization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;OpenFGA + grant projections&lt;br&gt;Required policy epoch acknowledged&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="445" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;4  Provision product data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Database placement • storage policy&lt;br&gt;Secrets and enabled product config&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1120" y="445" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="active" value="&lt;b&gt;7  Active&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Atomic registry transition&lt;br&gt;Only after all mandatory gates pass&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="pause" value="&lt;b&gt;Failure → inactive / resumable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Persist step + external resource IDs&lt;br&gt;Bounded retry • alert • reconcile&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#fff5df;strokeColor=#b88b32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="760" width="420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="close" value="&lt;b&gt;Lifecycle stays explicit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Suspend → closing → approved purge&lt;br&gt;Legal holds and audit survive&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;" vertex="1" parent="1">
