        <mxCell id="a" value="&lt;b&gt;Hospital A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Local staff • facilities • MRN&lt;br&gt;Clinical records + CRM contacts&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="365" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;Hospital B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Local staff • facilities • MRN&lt;br&gt;Clinical records + CRM contacts&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#edf4ff;strokeColor=#4975b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="445" y="365" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Hospital C&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Local staff • facilities • MRN&lt;br&gt;ISOLATED from A and B&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="365" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Hospital D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Own staff, records and CRM&lt;br&gt;No cross-tenant visibility&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#f0f3f7;strokeColor=#8d9aad;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1210" y="365" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="da" value="&lt;b&gt;A-owned data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Tenant G + hospital A&lt;br&gt;Source remains the owner&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="610" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;B-owned data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Tenant G + hospital B&lt;br&gt;Shared reads are explicit grants&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="445" y="610" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dc" value="&lt;b&gt;C-owned data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Tenant G + hospital C&lt;br&gt;No discovery from A or B&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="610" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dd" value="&lt;b&gt;D-owned data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Tenant H + hospital D&lt;br&gt;Independent isolation boundary&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=21;fontColor=#1d3652;fillColor=#e6f5f1;strokeColor=#368779;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1210" y="610" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Sharing is not a tenant-wide switch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Isolated / selective / approved group mode • directional • purpose-bound • revocable&lt;br&gt;Identity links ≠ clinical access ≠ CRM access ≠ finance / HR access&lt;br&gt;Tenant administrators do not automatically get access to patient records&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Arial;fontSize=23;fontColor=#1d3652;fillColor=#f3edff;strokeColor=#8663bc;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="1480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  Proposed design · 2026-10-13  /  Blue: apps   Purple: identity/policy   Teal: data   Amber: async   Dashed: secondary/future" style="text;html=0;align=left;fontSize=15;fontColor=#6c7b8d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1360" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="03-authorized-request" name="03 Every request crosses explicit security gates.">
    <mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
