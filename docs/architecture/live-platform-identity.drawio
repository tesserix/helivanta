<mxfile host="app.diagrams.net" type="device"><diagram id="live-identity-boundaries" name="Live identity and trading gates"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="PharmaConnect · Live identity before bilateral trading" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1450" height="65" /></mxCell><mxCell id="status" value="DESIGN STATUS: client tested locally · source PR #11 awaiting CI · relationship workflow not implemented or activated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="115" width="1450" height="60" /></mxCell><mxCell id="admin" value="Scoped buyer / seller administrator&#10;Own tenant and organisation only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="230" width="300" height="110" /></mxCell><mxCell id="api" value="PharmaConnect API&#10;Authorize local access and expected version&#10;Close read transaction before source I/O" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="220" width="360" height="140" /></mxCell><mxCell id="registry" value="Onboarding API · source PR #11&#10;Dedicated product machine&#10;Registry entitlement checked before + after I/O" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="870" y="220" width="360" height="140" /></mxCell><mxCell id="zitadel" value="Zitadel · live authority&#10;Organisation + tenant metadata&#10;Project + exact grant" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="870" y="440" width="360" height="125" /></mxCell><mxCell id="client" value="Implemented Helivanta client&#10;Exact tenant/product + schema 1&#10;Current time + 4 revision strings&#10;No cookies, redirect or cached fallback&#10;2 s deadline · 8 KiB bound" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="425" width="360" height="180" /></mxCell><mxCell id="deny" value="Unavailable / inactive / revoked&#10;Deny new eligibility-sensitive actions&#10;No stored-profile fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="435" width="300" height="150" /></mxCell><mxCell id="gates" value="Remaining business gates · NOT YET IMPLEMENTED&#10;Both parties approve same terms revision&#10;Reviewed premises / licences / country-category policy&#10;Validity, serviceability, currency and commercial access&#10;Cross-border disabled without separate authority" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="665" width="670" height="165" /></mxCell><mxCell id="write" value="Future final tenant transaction&#10;Recheck access and versions&#10;Append command + audit + outbox atomically&#10;Forced RLS remains in place" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="900" width="390" height="140" /></mxCell><mxCell id="async" value="Future durable coordination&#10;NATS JetStream: opaque IDs and provenance&#10;Temporal: deadlines, retries, reconciliation&#10;Destination-owned projections; stale ACKs denied" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="900" width="440" height="140" /></mxCell><mxCell id="e1" value="Requested transition" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="admin" target="api"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="Fresh HTTPS machine read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="registry"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="4 bounded parallel reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="registry" target="zitadel"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Minimized observation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="registry" target="client"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="Untrusted / inactive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#e11d48;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="deny"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="Active identity is only one gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#059669;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="gates"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="All gates satisfied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="gates" target="write"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="Transactional outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#475569;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1" source="write" target="async"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>
