<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="partner-membership" name="Independent supply and hospital membership"><mxGraphModel dx="1440" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1050"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Independent pharmacy collaboration | Ownership and admission" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontFamily=Helvetica;fontSize=24;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1360" height="65" /></mxCell><mxCell id="hospital" value="HOSPITAL ORGANIZATION&#10;Owns hospital Staff and departments" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="135" width="420" height="100" /></mxCell><mxCell id="pharma" value="INDEPENDENT PHARMACY&#10;Owns its own employer / Staff records" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="135" width="420" height="100" /></mxCell><mxCell id="supply" value="DISTRIBUTOR ORGANIZATION&#10;Owns its own employer / Staff records" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="135" width="420" height="100" /></mxCell><mxCell id="teams" value="Department teams&#10;Heads → supervisors → assigned Staff&#10;Reviewed postings and transfers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="275" width="420" height="105" /></mxCell><mxCell id="outlet" value="PharmaConnect outlet / branch&#10;SOURCE STOCK OWNER: PharmaConnect&#10;Hospital-operated or independently owned" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="275" width="420" height="105" /></mxCell><mxCell id="premise" value="SupplyConnect registered premise&#10;SOURCE STOCK OWNER: SupplyConnect&#10;Exact legal party, location and activity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="275" width="420" height="105" /></mxCell><mxCell id="group" value="Published hospital recipient group&#10;Procurement / receiving / finance&#10;Direct named hospital Staff only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="425" width="420" height="105" /></mxCell><mxCell id="membership" value="IAM membership candidate&#10;Nominate → independent review → approve&#10;Withdrawal / rejection / suspension + receipts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="580" width="420" height="110" /></mxCell><mxCell id="relationship" value="BILATERAL RELATIONSHIP — consuming work pending&#10;Exact parties + source/destination locations + reviewed licence/activity/category evidence&#10;India: Maharashtra IN-MH and Odisha IN-OD; each jurisdiction assessed independently" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="425" width="890" height="105" /></mxCell><mxCell id="grant" value="SHARED IAM EXTERNAL GRANT — consuming work pending&#10;Named user or hospital-published group; both-party consent&#10;Exact purpose / actions / fields / location / validity ceiling" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="580" width="890" height="110" /></mxCell><mxCell id="admission" value="EVERY ACCESS: current session + home Staff/link/generation + membership + grant + relationship&#10;Source owner checks audience, purpose, participating object and allowed fields. Unavailable authority denies." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="745" width="1360" height="95" /></mxCell><mxCell id="handoff" value="TRADE HANDOFF — consuming work pending&#10;Hospital order → source-owner dispatch → receiving-owner receipt / discrepancy / quarantine&#10;Invoices, credits and settlement stay with their financial owners. Sharing never moves stock or money." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="885" width="1360" height="110" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;stroke