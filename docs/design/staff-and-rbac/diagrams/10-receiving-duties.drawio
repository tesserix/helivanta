<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0"><diagram name="Receiving duty boundaries" id="receiving-duty-boundaries"><mxGraphModel dx="1480" dy="1160" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1480" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Independent supplier receiving | Unreleased candidate | IN-MH / IN-OD" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1400" height="65" as="geometry" /></mxCell><mxCell id="workforce" value="&lt;b&gt;Workforce · employer and identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Employer: supplier / pharmacy organization&lt;br&gt;Private Staff directory and current version&lt;br&gt;Reviewed named-account link and current version&lt;br&gt;Employer access remains private to its owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f5f0;strokeColor=#21765c;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="440" height="230" as="geometry" /></mxCell><mxCell id="iam" value="&lt;b&gt;Shared IAM · operating authority&lt;/b&gt;&lt;br&gt;&lt;br&gt;One exact source location and reviewed Staff link&lt;br&gt;Immutable preparation and decision receipts&lt;br&gt;Uninterrupted membership and independent review&lt;br&gt;No hospital identity inferred from a supplier ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eaf1ff;strokeColor=#345ca8;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="440" height="230" as="geometry" /></mxCell><mxCell id="source" value="&lt;b&gt;Product owners · separate stock&lt;/b&gt;&lt;br&gt;&lt;br&gt;SupplyConnect owns warehouse / depot stock&lt;br&gt;PharmaConnect owns outlet stock&lt;br&gt;Drug master owns product and pack identity&lt;br&gt;A role never transfers stock ownership" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef2fa;strokeColor=#4f5d7b;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="440" height="230" as="geometry" /></mxCell><mxCell id="prepare" value="&lt;b&gt;1 · Prepare&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current employer manager&lt;br&gt;Exact source and Staff / account versions&lt;br&gt;Bounded validity and attributable reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f5f0;strokeColor=#21765c;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="320" height="130" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;2 · Independent review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current separate reviewer&lt;br&gt;Maker and target aliases excluded&lt;br&gt;Approve, reject, withdraw or revoke" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f5f0;strokeColor=#21765c;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="320" height="130" as="geometry" /></mxCell><mxCell id="publish" value="&lt;b&gt;3 · Pending activation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Immutable outbox and snapshot&lt;br&gt;Publish to OpenFGA outside DB locks&lt;br&gt;Current basis rechecked before ACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff4d9;strokeColor=#9a701b;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="320" height="130" as="geometry" /></mxCell><mxCell id="consume" value="&lt;b&gt;4 · Current action check&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact graph ACK, epoch and validity&lt;br&gt;Current Staff / source / membership&lt;br&gt;Credential cutoff through commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f5f0;strokeColor=#21765c;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="320" height="130" as="geometry" /></mxCell><mxCell id="supply" value="&lt;b&gt;SupplyConnect · implemented candidate consumer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact warehouse barcode lookup → published stock-purpose reference&lt;br&gt;Physical receipt → immutable original quarantine evidence&lt;br&gt;Product / pack observation → append-only verified identity evidence&lt;br&gt;Immediate duty cutoff; audit and recovery; no available stock inferred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e9f5f0;strokeColor=#21765c;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="860" height="180" as="geometry" /></mxCell><mxCell id="pharma" value="&lt;b&gt;PharmaConnect · consumer remains open&lt;/b&gt;&lt;br&gt;&lt;br&gt;Its outlet stock remains the sole owner&lt;br&gt;Receiving template exists in Shared IAM&lt;br&gt;Actual scoped product consumer and receiver&lt;br&gt;browser acceptance remain unfinished" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f1f3f7;strokeColor=#758096;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="940" y="660" width="500" height="180" as="geometry" /></mxCell><mxCell id="remaining" value="&lt;b&gt;Remaining full supplier workflow · not implemented by receiving duties&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bilateral relationship → hospital named / group grants → minimized authorized disclosure&lt;br&gt;Qualified release → owner balance and reservation → dispatch → destination quarantine / discrepancy / receipt&lt;br&gt;Invoice / credit / payable / settlement composition → complete acceptance → exact reviewed Kargo release" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f1f3f7;strokeColor=#758096;fontColor=#27354b;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1400" height="150" as="geometry" /></mxCell><mxCell id="edge0" edge="1" parent="1" source="workforce" target="iam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" edge="1" parent="1" source="iam" target="source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" edge="1" parent="1" source="prepare" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" edge="1" parent="1" source="review" target="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" edge="1" parent="1" source="publish" target="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" edge="1" parent="1" source="consume" target="supply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#66758c;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>