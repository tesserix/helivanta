<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0"><diagram name="Fulfilment and hospital receiving" id="supplier-fulfilment-receiving"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Supplier fulfilment &amp;amp; hospital receiving&lt;/b&gt;&lt;br&gt;Separate source owners and accountable destination evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=30;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1840" height="75" /></mxCell><mxCell id="supply-frame" value="&lt;b&gt;1  Supply-owned warehouse stock&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f6fd;strokeColor=#8ca9d0;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="250" width="570" height="400" /></mxCell><mxCell id="pharma-frame" value="&lt;b&gt;2  Pharma-owned outlet stock&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef8f6;strokeColor=#82b8ad;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="250" width="570" height="400" /></mxCell><mxCell id="buyer-frame" value="&lt;b&gt;3  Hospital receiving — Pharma owner&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f2fc;strokeColor=#b09bd3;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="250" width="600" height="950" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="supply-hold" target="supply-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-1" edge="1" parent="1" source="pharma-hold" target="pharma-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-2" edge="1" parent="1" source="supply-owner" target="supply-hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-3" edge="1" parent="1" source="pharma-owner" target="pharma-hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-4" edge="1" parent="1" source="supply-dispatch" target="supply-ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-5" edge="1" parent="1" source="pharma-dispatch" target="pharma-ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-6" edge="1" parent="1" source="supply-ledger" target="exchange" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-7" edge="1" parent="1" source="pharma-ledger" target="exchange" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-8" edge="1" parent="1" source="exchange" target="buyer-shipment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1250" y="770" /><mxPoint x="1250" y="355" /></Array></mxGeometry></mxCell><mxCell id="edge-9" edge="1" parent="1" source="buyer-shipment" target="receive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-10" edge="1" parent="1" source="receive" target="correct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-11" edge="1" parent="1" source="receive" target="close" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-12" edge="1" parent="1" source="correct" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-13" edge="1" parent="1" source="close" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-14" edge="1" parent="1" source="review" target="release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-15" edge="1" parent="1" source="receive" target="source-response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1235" y="490" /><mxPoint x="1235" y="950" /></Array></mxGeometry></mxCell><mxCell id="edge-16" edge="1" parent="1" source="source-response" target="annotation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#586e8b;strokeWidth=2;endArrow=block;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1265" y="975" /><mxPoint x="1265" y="1105" /></Array></mxGeometry></mxCell><mxCell id="authority" value="&lt;b&gt;Current authority at every boundary&lt;/b&gt;&lt;br&gt;Verified Zitadel tenant + account • IAM purpose and exact scope • Workforce Staff identity&lt;br&gt;Hospital: department and governed outlet. Independent: employer and operating location. Revocation and outages fail closed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#142d4e;strokeColor=#142d4e;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="110" width="1840" height="100" /></mxCell><mxCell id="supply-owner" value="&lt;b&gt;Current warehouse Staff&lt;/b&gt;&lt;br&gt;One Supply ledger owns physical stock and holds.&lt;br&gt;Current warehouse purpose and premise remain required." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="310" width="530" height="90" /></mxCell><mxCell id="supply-hold" value="&lt;b&gt;Reserve a hold&lt;/b&gt;&lt;br&gt;No physical debit yet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1ecfc;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="420" width="250" height="80" /></mxCell><mxCell id="supply-dispatch" value="&lt;b&gt;Partial dispatch&lt;/b&gt;&lt;br&gt;Debits this source only." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1ecfc;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="420" width="250" height="80" /></mxCell><mxCell id="supply-ledger" value="&lt;b&gt;Immutable source evidence&lt;/b&gt;&lt;br&gt;Bounded allocations, dispatches, hold release and recovery." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="530" width="530" height="80" /></mxCell><mxCell id="pharma-owner" value="&lt;b&gt;Current pharmacy source Staff&lt;/b&gt;&lt;br&gt;Independent: own outlet Staff. Hospital-owned:&lt;br&gt;current department pharmacy fulfilment duty." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#398e7e;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="310" width="530" height="90" /></mxCell><mxCell id="pharma-hold" value="&lt;b&gt;Reserve a hold&lt;/b&gt;&lt;br&gt;No physical debit yet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dff2ec;strokeColor=#398e7e;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="420" width="250" height="80" /></mxCell><mxCell id="pharma-dispatch" value="&lt;b&gt;Partial dispatch&lt;/b&gt;&lt;br&gt;Debits this source only." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dff2ec;strokeColor=#398e7e;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="420" width="250" height="80" /></mxCell><mxCell id="pharma-ledger" value="&lt;b&gt;Immutable source evidence&lt;/b&gt;&lt;br&gt;The pharmacy owns its ledger; warehouse tables stay separate." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#398e7e;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="530" width="530" height="80" /></mxCell><mxCell id="exchange" value="&lt;b&gt;Directed owner facts, with durable replay&lt;/b&gt;&lt;br&gt;Exact order and shipment identity • source stock owner • buyer hospital / department / outlet&lt;br&gt;Source debit and outbox commit together. Supply owns the verified buyer shipment projection.&lt;br&gt;PharmaConnect records destination stock through its own receiving transaction." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf1f6;strokeColor=#6c829e;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="710" width="1180" height="120" /></mxCell><mxCell id="source-response" value="&lt;b&gt;Source reconciliation under a separate current response purpose&lt;/b&gt;&lt;br&gt;Inspect the latest hospital receiving version; confirm or dispute with attributable evidence.&lt;br&gt;Freeze the original command for retry or recovery. Commit the response and directed outbox atomically.&lt;br&gt;Only the exact buyer receives the annotation. Private source Staff identity remains source-local." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="890" width="1180" height="120" /></mxCell><mxCell id="financial" value="&lt;b&gt;Financial ownership stays separate&lt;/b&gt;&lt;br&gt;Receiving, shortage closure, clearance, stock release and supplier replies do not create invoices,&lt;br&gt;credit notes, payables or settlements. Full financial composition remains a separate acceptance gate.&lt;br&gt;These operational records preserve the evidence needed for that composition." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff5df;strokeColor=#c4983b;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1060" width="1180" height="140" /></mxCell><mxCell id="buyer-shipment" value="&lt;b&gt;Verify the exact dispatched shipment&lt;/b&gt;&lt;br&gt;Current hospital / department / outlet admission.&lt;br&gt;Owner proof and read audit; no supplied ID grants access." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064b2;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="310" width="560" height="90" /></mxCell><mxCell id="receive" value="&lt;b&gt;Inspect and count into quarantine&lt;/b&gt;&lt;br&gt;Choose the actual destination product version and lot.&lt;br&gt;Inspect strength, formulation, pack, units, expiry and MRP.&lt;br&gt;Accepted + rejected equals the recorded physical count." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eee7fa;strokeColor=#8064b2;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="435" width="560" height="110" /></mxCell><mxCell id="correct" value="&lt;b&gt;Correct if required&lt;/b&gt;&lt;br&gt;Independent reviewer and&lt;br&gt;pinned receipt / summary versions.&lt;br&gt;Original evidence is preserved." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064b2;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="580" width="270" height="110" /></mxCell><mxCell id="close" value="&lt;b&gt;Close receiving&lt;/b&gt;&lt;br&gt;Record all missing units as short.&lt;br&gt;Entirely short is an explicit&lt;br&gt;closure, without a stock receipt." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064b2;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1590" y="580" width="270" height="110" /></mxCell><mxCell id="review" value="&lt;b&gt;Independent clearance at the current closed version&lt;/b&gt;&lt;br&gt;The original recorder cannot review their own receipt.&lt;br&gt;review_recorded is review evidence; it does not move stock." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eee7fa;strokeColor=#8064b2;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="725" width="560" height="100" /></mxCell><mxCell id="release" value="&lt;b&gt;Physically release to the actual sellable shelf&lt;/b&gt;&lt;br&gt;One transaction: receipt journal + source/shelf movements + outbox.&lt;br&gt;Recheck provenance, product, tax, schedule, MRP, expiry and safety.&lt;br&gt;All releases stay within this receipt’s effective accepted units.&lt;br&gt;Current authority and original-actor recovery remain required." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f3ec;strokeColor=#43866b;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="870" width="560" height="130" /></mxCell><mxCell id="annotation" value="&lt;b&gt;Supplier-authored hospital annotations&lt;/b&gt;&lt;br&gt;Version-pinned responses remain separate from effective counts.&lt;br&gt;They do not alter hospital stock or financial records." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#4e79ac;strokeWidth=1.5;fontColor=#172b4d;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1300" y="1055" width="560" height="100" /></mxCell><mxCell id="status" value="&lt;b&gt;Implementation candidate • India: Maharashtra and Odisha&lt;/b&gt;&lt;br&gt;Native checks and real-owner CI provide distinct evidence. Shared environment browser acceptance and exact Kargo promotion remain release gates.&lt;br&gt;The diagram does not assert deployed availability, financial completion, medicine equivalence or legal certification." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#142d4e;strokeColor=#142d4e;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;spacingRight=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1250" width="1840" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>