        <mxCell id="view" value="&lt;b&gt;Authorized H1 business view&lt;/b&gt;&lt;br&gt;H1 offers / orders / shipments / invoices&lt;br&gt;Minimum approved fields and actions&lt;br&gt;No other customer, private HR or PHI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#37465b;fillColor=#f1f4f8;strokeColor=#adb9c9;strokeWidth=1.5;" vertex="1" parent="1">
