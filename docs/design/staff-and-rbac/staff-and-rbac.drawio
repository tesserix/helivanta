          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60748c;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#52657e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="link" target="grant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60748c;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#52657e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trigger" target="deny">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60748c;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#52657e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deny" target="reconcile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="intake" value="&lt;b&gt;1  Intake → employer review → active engagement&lt;/b&gt;&lt;br&gt;No business access from staff creation or a job title" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#155642;fillColor=#e6f5f0;strokeColor=#75b7a1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="225" width="660" height="85" as="geometry" />
        </mxCell>
        <mxCell id="link" value="&lt;b&gt;2  Dated posting + independently reviewed login link&lt;/b&gt;&lt;br&gt;Explicit membership as required; posting proposes access" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#155642;fillColor=#e6f5f0;strokeColor=#75b7a1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="660" height="85" as="geometry" />
        </mxCell>
        <mxCell id="grant" value="&lt;b&gt;3  Approve exact assignment → project → activate&lt;/b&gt;&lt;br&gt;Independent reviewer and current evidence&lt;br&gt;Pending projection never becomes a temporary allow" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#155642;fillColor=#e6f5f0;strokeColor=#75b7a1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="&lt;b&gt;1  Effective lifecycle event or urgent suspension&lt;/b&gt;&lt;br&gt;Posting end, evidence expiry, service end or employment exit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#6c4e13;fillColor=#fff4dd;strokeColor=#d5af56;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="225" width="660" height="85" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;2  Authoritative current-state denial first&lt;/b&gt;&lt;br&gt;Commit revoke / epoch / audit + outbox; stale graph cannot allow" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#7e302b;fillColor=#fceceb;strokeColor=#d58e89;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="390" width="660" height="85" as="geometry" />
        </mxCell>
        <mxCell id="reconcile" value="&lt;b&gt;3  Reconcile projections and dependent grants&lt;/b&gt;&lt;br&gt;Bounded retry, deduplication and visible repair queue&lt;br&gt;New scope / rehire needs new reviewed authority" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#6c4e13;fillColor=#fff4dd;strokeColor=#d5af56;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="555" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="&lt;b&gt;Preserve history; never revive access by replay&lt;/b&gt;&lt;br&gt;No approval wait for revocation. No deletion of completed clinical / stock / financial evidence. No old-snapshot reactivation." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#ffffff;fillColor=#0f2745;strokeColor=#0f2745;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="180" y="825" width="1240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="HELIVANTA  /  STAFF &amp; ACCESS DESIGN     •     06 NOV 2026     •     PROPOSED TARGET — NOT DEPLOYED" style="text;html=0;align=left;fontFamily=Helvetica;fontSize=13;fontColor=#52657e;" vertex="1" parent="1">
          <mxGeometry x="50" y="945" width="1500" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
