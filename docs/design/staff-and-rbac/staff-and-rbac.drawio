          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;1  H1 order request + independent approval&lt;/b&gt;&lt;br&gt;Approved relationship, exact destination, units and order revision" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#173a65;fillColor=#eaf2ff;strokeColor=#8bafe0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="660" height="95" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;2  Supplier accepts or proposes changes&lt;/b&gt;&lt;br&gt;H1 accepts authorized changes; no unilateral substitution" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#155642;fillColor=#e6f5f0;strokeColor=#75b7a1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="220" width="660" height="95" as="geometry" />
        </mxCell>
        <mxCell id="receive" value="&lt;b&gt;4  H1 counts receipt and records discrepancy&lt;/b&gt;&lt;br&gt;Quality / safety review is separate from a delivery signature" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#173a65;fillColor=#eaf2ff;strokeColor=#8bafe0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;b&gt;3  P posts its own dispatch → in transit&lt;/b&gt;&lt;br&gt;Eligible source stock, lots / expiry, quantities and transport evidence" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#155642;fillColor=#e6f5f0;strokeColor=#75b7a1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="420" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="payable" value="&lt;b&gt;5  Destination receipt + payable review&lt;/b&gt;&lt;br&gt;Destination owner posts stock; receipt does not mean payment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;fontColor=#173a65;fillColor=#eaf2ff;strokeColor=#8bafe0;strokeWidth=1.5;" vertex="1" parent="1">
