<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="staff-enrollment" name="Staff enrollment security and data flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="HELIVANTA · HOSPITAL STAFF ENROLLMENT" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#ffffff;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1280" height="50" /></mxCell><mxCell id="ui" value="Unified staff workspace&#10;Identity · employment · contact · credentials" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="150" width="260" height="110" /></mxCell><mxCell id="auth" value="Verified tenant membership&#10;Enrollment permission + explicit hospital manager" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ccfbf1;strokeColor=#0d9488;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="150" width="280" height="110" /></mxCell><mxCell id="tx" value="One PostgreSQL transaction&#10;Version guard · stable IDs · casefold unique code" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="700" y="150" width="290" height="110" /></mxCell><mxCell id="data" value="Protected enrollment&#10;Profile + addresses + contacts&#10;Credentials + qualifications + experience" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#0f172a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="700" y="350" width="290" height="140" /></mxCell><mxCell id="rls" value="FORCED RLS + composite foreign keys&#10;Tenant AND hospital isolation&#10;Trans