# Spike-only reverse proxy for issue #838's v4.15.3 P1 re-verification.
# Mirrors, at spike scale, the real official compose's Traefik routing
# (github.com/zitadel/zitadel deploy/compose/docker-compose.yml): core
# serves everything EXCEPT /ui/v2/login/*, which the separate
# zitadel-login service serves — both merged under one origin, because
# the browser's redirect target (built from ZITADEL_EXTERNALDOMAIN/PORT)
# has no way to know two different backend processes are involved.
:8080 {
	@login path /ui/v2/login/*
	handle @login {
		reverse_proxy zitadel-login:3000
	}
	handle {
		reverse_proxy zitadel:8080
	}
}
